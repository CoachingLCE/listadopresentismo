# ID de la hoja de Google Sheets "Presentismo ILCE" (lo sacás de la URL del Sheet)
GOOGLE_SHEET_ID=

# Cuenta de servicio — LA MISMA que ya usás en Cronograma ILCE / Salas Zoom / Seguimiento Lead.
# No hace falta crear credenciales nuevas: alcanza con compartir este Sheet nuevo con este
# mismo email como Editor (ver SETUP.md).
GOOGLE_SERVICE_ACCOUNT_EMAIL=carga-clases-bot@carga-clases-ilce.iam.gserviceaccount.com

# La private_key del JSON de esa cuenta de servicio, tal cual (con los \n literales — Vercel
# la interpreta bien si la pegás con comillas dobles alrededor). Es la MISMA que ya tenés
# cargada en las otras apps del ILCE.
GOOGLE_PRIVATE_KEY=

# Secreto para firmar el token de sesión (cualquier string largo y random, por ejemplo con
# `openssl rand -hex 32`). Obligatorio en producción.
SESSION_SECRET=

# Llave temporal para que cada persona asigne su PRIMERA contraseña (vía /setup-password).
# Elegí cualquier texto largo y random. Se la pasás una vez a cada usuario nuevo.
SETUP_BOOTSTRAP_KEY=

# Cuenta de Gmail para los futuros avisos automáticos (no se usa todavía en esta primera
# entrega, pero queda preparado para cuando sumemos las alertas semanales).
GMAIL_USER=coachingeducacionallider@gmail.com
GMAIL_APP_PASSWORD=
